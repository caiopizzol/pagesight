{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "scope": "website",
            "release": false
          }
        ]
      }
    ],
    "semantic-release-ai-notes",
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "packages/pagesight"
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": ["packages/pagesight/package.json", "bun.lock"]
      }
    ]
  ]
}
