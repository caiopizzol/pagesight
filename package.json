{
  "name": "pagesight-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run --filter pagesight start",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.json && bun run --workspaces typecheck",
    "test": "bun run --workspaces test",
    "lint": "vp lint",
    "format": "vp fmt",
    "verify": "bun run check && bun run typecheck && bun run test",
    "test:package": "bun scripts/check-package.ts",
    "prepare": "bun -e \"if (await Bun.file('node_modules/vite-plus/bin/vp').exists()) process.exit(Bun.spawnSync(['node', 'node_modules/vite-plus/bin/vp', 'config', '--no-agent'], { stdout: 'inherit', stderr: 'inherit' }).exitCode)\""
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/bun": "^1.3.11",
    "semantic-release": "^25.0.3",
    "semantic-release-ai-notes": "^0.2.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "packageManager": "bun@1.3.12"
}
