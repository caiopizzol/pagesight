{
  "name": "sitelint",
  "version": "0.1.0",
  "description": "Lint your site for search engines and AI. Powered by Google Search Console.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "sitelint": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "^1.3.11",
    "lefthook": "^2.1.4"
  }
}
