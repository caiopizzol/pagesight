    "mcp",
    "pagespeed-insights",
    "robots-txt",
    "seo",
    "web-performance"
  ],
  "homepage": "https://github.com/caiopizzol/pagesight",
  "license": "MIT",
  "author": "Caio Pizzol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiopizzol/pagesight.git",
    "directory": "packages/pagesight"
  },
  "bin": {
